# Copenhagen Data Lab — optional overrides. No secrets are required:
# the StatBank API is public and needs no key.

# Root directory for snapshot, warehouse, run log and raw archives (default: ./data)
# CDL_DATA_DIR=./data

# StatBank API settings
# CDL_API_BASE_URL=https://api.statbank.dk/v1
# CDL_REQUEST_TIMEOUT_S=60
# CDL_MAX_RETRIES=4

# Restrict the reporting periods requested from the API (StatBank codes, e.g. 2015K1)
# CDL_FIRST_PERIOD=2015K1
# CDL_LAST_PERIOD=

# Logging: INFO or DEBUG; set CDL_LOG_JSON=1 for one JSON object per line
# CDL_LOG_LEVEL=INFO
# CDL_LOG_JSON=0

# Opt in to the live StatBank smoke test
# CDL_LIVE_TESTS=1
